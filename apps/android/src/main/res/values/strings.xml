    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_tagline">Recognition, kept honestly.</string>
    <string name="about_subtitle">A sovereign, local-first shell over a non-custodial core.</string>
    <string name="about_purpose_title">What TLC is for</string>
    <string name="about_purpose">TLC exists to make care and contribution visible between people who trust each other, and to keep the record of it beyond the reach of a quiet edit. It is for families, small circles, community groups and cooperatives: anyone who wants a trustworthy memory of who showed up for whom, without handing that memory to a company.</string>
    <string name="about_not_money_title">What it will never do</string>
    <string name="about_now_title">In this build</string>
    <string name="about_now">The journal is durable and hash-chained. You can recognise someone, pledge and witness a Growth Grant, record a Pioneer due, name a Co-Steward, open a two-key decision, choose a theme and restore a verified backup. There is still no account, no sync and no multi-device merge.</string>
    <string name="about_next_title">Not here yet</string>
    <string name="about_next">Accounts, cross-device invitations, sync, the remote Pioneer attestation desk and multi-device merge are the next milestone. Records do not leave this device unless you export or share them.</string>
    <string name="about_modules_title">Capabilities and modules</string>
    <string name="about_modules_body">Journal · Growth Grants · Pioneer dues · Stewardship · Verification · Portability. One core, many shells; the Android shell owns pixels, never rules.</string>
    <string name="about_meta_title">This copy</string>
    <string name="about_version">Version %1$s (build %2$d)</string>
    <string name="about_licence">GPL-3.0-or-later. No analytics, no advertising identifier, no third-party tracking.</string>
    <string name="about_source">github.com/OriginLabs1/TheLoveCulture-TLC</string>
    <string name="about_stores">GitHub Releases · F-Droid · Orion Store · Uptodown</string>
    <string name="about_contact_title">Pioneer contact</string>
    <string name="about_contact_body">Direct, human contact for TLC. Opened by the system; nothing is copied into the record.</string>
