<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- v0.0.8 introduces the shared plane: a live, consented connection to the TLC relay for
         encrypted one-to-one messages and presence. It is still not a hosted account for the private
         record: the ledger, bank vault, drafts, photos and receipts stay on this device and work in
         airplane mode. The relay sees routing metadata (handle, timing, size, IP), never message
         text or private record content. See PRIVACY.md and docs/PLAN-v0.0.8.md. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.TLC">


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Link doctrine: one link, correct destination, meaningful fallback (CONTEXT §7).
                 The universal-link filter for https://tlc.app is deliberately absent until that
                 host serves /.well-known/assetlinks.json with this app's signing certificate.
                 An unverifiable app link cannot open the app, so shipping the filter would claim
                 a domain the project does not yet control. Add it (and the assetlinks file) in
                 the same change that makes it true. -->
        </activity>

        <!-- One private folder, one narrow grant. Receipt sharing is user-initiated: the app
             hands a single downscaled JPEG to the chooser through a content URI and nothing
             else is reachable. The provider never exposes the vault, the state file or the
             ledger, and there is still no storage permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
