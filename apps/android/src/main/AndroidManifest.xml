<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission. v0.0.1 has no networking code and no HTTP client on its
         classpath, so asking for network access would be a promise the app cannot keep in
         either direction: it would let a future mistake send data out, and it would make
         "nothing leaves the device" a claim users have to take on trust. The permission
         returns only when a feature needs it, and then the privacy policy changes first. -->

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TLC">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Link doctrine: one link, correct destination, meaningful fallback (CONTEXT §7).
                 The universal-link filter for https://tlc.app is deliberately absent until that
                 host serves /.well-known/assetlinks.json with this app's signing certificate.
                 An unverifiable app link cannot open the app, so shipping the filter would claim
                 a domain the project does not yet control. Add it (and the assetlinks file) in
                 the same change that makes it true. -->
        </activity>

        <!-- One private folder, one narrow grant. Receipt sharing is user-initiated: the app
             hands a single downscaled JPEG to the chooser through a content URI and nothing
             else is reachable. There is still no INTERNET permission and no storage permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
